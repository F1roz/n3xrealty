{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/crm", "destination": "/ai-crm", "permanent": true },
    { "source": "/automation", "destination": "/ai-automation", "permanent": true },
    { "source": "/lg", "destination": "/lead-generation", "permanent": true },
    { "source": "/ln", "destination": "/ai-lead-nurture", "permanent": true },
    { "source": "/sg", "destination": "/seo-geo", "permanent": true },
    { "source": "/smm", "destination": "/social-media-marketing", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
